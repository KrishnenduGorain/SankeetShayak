{
  "folders": [
    {
      "name": "1. Backend Core & APIs (src/)",
      "path": "src"
    },
    {
      "name": "2. Pre-Trained Models & Weights (models/)",
      "path": "models"
    },
    {
      "name": "3. Automated Test Suite (tests/)",
      "path": "tests"
    },
    {
      "name": "4. Web Dashboard Assets (web/)",
      "path": "web"
    },
    {
      "name": "5. Root Configurations & Deployment",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests",
      "-v"
    ],
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/__pycache__": false,
      "hs": true,
      "venv": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run FastAPI Backend (Uvicorn)",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "src.api.main:app",
          "--host",
          "0.0.0.0",
          "--port",
          "8000",
          "--reload"
        ],
        "jinja": true,
        "justMyCode": true
      },
      {
        "name": "Run Backend Diagnostic (verify_backend.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/verify_backend.py",
        "console": "integratedTerminal"
      },
      {
        "name": "Run All Pytest Tests",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "tests/",
          "-v"
        ],
        "console": "integratedTerminal"
      }
    ]
  }
}
