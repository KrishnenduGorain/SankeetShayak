# ==============================================================================
# SankeetShayak Backend Production Configuration Example
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# --- Client Host & CORS (Cross-Origin Resource Sharing) ---
CLIENT_HOST=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://*.vercel.app,https://*.onrender.com,*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,*
FRONTEND_URL=http://localhost:5173

# --- Model & Vision Asset Paths ---
MODEL_PATH=models/handshayak_model.joblib
MEDIAPIPE_TASK_PATH=models/hand_landmarker.task

# --- Camera & Vision Settings ---
DEFAULT_CAMERA_INDEX=0
DEFAULT_FPS=30.0

# --- Biomechanical Physics Engine Defaults ---
HAND_MASS_KG=0.40
SAVGOL_WINDOW=7
SAVGOL_POLYORDER=2

# --- Streaming Buffer Settings ---
STREAM_BUFFER_SIZE=30
MIN_FRAMES_INFERENCE=15
