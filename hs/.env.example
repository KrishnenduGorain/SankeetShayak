# Copy to .env (optional; every value has a default)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500
MODEL_PATH=models/handshayak_model.joblib
MEDIAPIPE_TASK_PATH=models/hand_landmarker.task
HAND_MASS_KG=0.40
SAVGOL_WINDOW=7
SAVGOL_POLYORDER=3

# Rendering / CI switches
# HANDSHAYAK_HEADLESS=1          never open OpenCV windows (set this in CI)
# HANDSHAYAK_SKIP_LIB_CHECK=1    skip the Linux system-library check (exotic distros)
# HANDSHAYAK_OFFLINE=1           never download the MediaPipe model
